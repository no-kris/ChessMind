{
  "mcpServers": {
    "coursetools_orchestrator": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.2,<2",
        "python",
        "mcp/tools_server.py"
      ],
      "env": {
        "COURSETOOLS_ROLE": "orchestrator"
      }
    },
    "coursetools_planner": {
