{
  "permissions": {
    "allow": [
      "Read(/.memory/knowledge/**)",
      "Read(/.memory/reference/**)"
    ],
    "deny": [
      "Edit(/.memory/knowledge/**)",
      "Edit(/.memory/reference/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-memory.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
